{
  "name": "pico-accountancy",
  "description": "Accountancy script for very simple cases",
  "version": "0.4.0",
  "author": {
    "name": "Olivier Huin",
    "url": "https://github.com/olih"
  },
  "keywords": [
    "CLI",
    "Accountancy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/flarebyte/pico-accountancy",
  "repository": {
    "type": "git",
    "url": "https://github.com/flarebyte/pico-accountancy.git"
  },
  "bugs": "https://github.com/flarebyte/pico-accountancy/issues",
  "bin": {
    "pico-accountancy": "dist/cli.mjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/cli.mjs",
      "default": "./dist/cli.mjs",
      "types": "./src"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "test": "tsx --test test/*.test.ts",
    "cli": "tsx src/cli.mts",
    "test:cov": "c8 --reporter=text-summary --reporter=lcov yarn -s test"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "dist/**",
      "test/**",
      "pest-spec/**",
      "spec/**",
      "**/*.d.ts"
    ]
  },
  "dependencies": {
    "commander": "^10.0.0",
    "fs-jetpack": "^5.1.0",
    "moment": "^2.29.4",
    "zod": "^3.20.6"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "baldrick-dev-ts": "^1.0.0",
    "baldrick-tsconfig-es2024": "^0.5.0",
    "c8": "^10.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
